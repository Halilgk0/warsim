{
  "name": "warsim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim:bench": "esbuild tools/sim/bench.ts --bundle --platform=node --format=esm --outfile=tools/sim/.out/bench.mjs --log-level=error && node tools/sim/.out/bench.mjs",
    "sim:hits": "esbuild tools/sim/hitkill.ts --bundle --platform=node --format=esm --outfile=tools/sim/.out/hitkill.mjs --log-level=error && node tools/sim/.out/hitkill.mjs"
  },
  "dependencies": {
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@types/three": "^0.172.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
