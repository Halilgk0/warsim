{
  "name": "warsim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p worker --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p worker --noEmit",
    "sim:bench": "esbuild tools/sim/bench.ts --bundle --platform=node --format=esm --outfile=tools/sim/.out/bench.mjs --log-level=error && node tools/sim/.out/bench.mjs",
    "sim:hits": "esbuild tools/sim/hitkill.ts --bundle --platform=node --format=esm --outfile=tools/sim/.out/hitkill.mjs --log-level=error && node tools/sim/.out/hitkill.mjs",
    "sim:flak": "esbuild tools/sim/flak.ts --bundle --platform=node --format=esm --outfile=tools/sim/.out/flak.mjs --log-level=error && node tools/sim/.out/flak.mjs",
    "sim:ceiling": "esbuild tools/sim/tavan.ts --bundle --platform=node --format=esm --outfile=tools/sim/.out/tavan.mjs --log-level=error && node tools/sim/.out/tavan.mjs",
    "uretim:gorsel": "node tools/uretim/gorseller.mjs",
    "db:local": "wrangler d1 migrations apply warsimbox --local",
    "serve": "wrangler dev",
    "deploy": "npm run build && wrangler d1 migrations apply warsimbox --remote && wrangler deploy"
  },
  "dependencies": {
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/three": "^0.172.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "workerd@1.20261023.1": true
  }
}
